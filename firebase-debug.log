edIn();\\r\\n    }\\r\\n\\r\\n    match /rooms/{roomId} {\\r\\n      allow read: if signedIn();\\r\\n      allow create, update, delete: if signedIn();\\r\\n    }\\r\\n\\r\\n    match /devices/{deviceId} {\\r\\n      allow read: if signedIn();\\r\\n      allow create, delete: if signedIn();\\r\\n\\r\\n      // The field list is closed: an unknown field name is rejected rather\\r\\n      // than silently stored. With three separate clients writing to one\\r\\n      // collection, that is what keeps them honest about the schema -- a typo\\r\\n      // fails loudly instead of creating a field nobody reads.\\r\\n      allow update: if signedIn()\\r\\n        && validStatus()\\r\\n        && noBackendOnlyFields()\\r\\n        && changed().hasOnly([\\r\\n             'id', 'name', 'type', 'roomId', 'floorId',\\r\\n             'status', 'statusReason', 'turnedOnAt',\\r\\n             'childSwitches', 'switches',\\r\\n             'maxOnDurationMinutes',\\r\\n             'scheduleStartTime', 'scheduleEndTime',\\r\\n             'scheduleDays', 'scheduleEnabled',\\r\\n             'cameraImageUrls', 'iconName', 'powerUsage',\\r\\n             'lastHeartbeat', 'updatedBy', 'lastUpdated'\\r\\n           ]);\\r\\n    }\\r\\n\\r\\n    // Usage history is evidence. The worker writes it through the Admin SDK;\\r\\n    // no client can add to it, edit it, or quietly erase a session.\\r\\n    match /usage_logs/{logId} {\\r\\n      allow read: if signedIn();\\r\\n      allow write: if false;\\r\\n    }\\r\\n\\r\\n    // Alerts are raised by the worker. A client may only acknowledge one.\\r\\n    match /alerts/{alertId} {\\r\\n      allow read: if signedIn();\\r\\n      allow create: if false;\\r\\n      allow update: if signedIn() && changed().hasOnly(['acknowledged']);\\r\\n      allow delete: if signedIn();\\r\\n    }\\r\\n\\r\\n    // Anything not named above is closed.\\r\\n    match /{document=**} {\\r\\n      allow read, write: if false;\\r\\n    }\\r\\n  }\\r\\n}\\r\\n\"}]}}