[debug] [2026-08-16T16:31:23.574Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/smartnest-f9b99/rulesets {"name":"projects/smartnest-f9b99/rulesets/fce77150-de84-4533-85c6-5c1951a8e3dc","source":{"files":[{"content":"rules_version = '2';\r\n\r\n// Security rules for Smart Nest.\r\n//\r\n// Canonical schema: firebase/SCHEMA.md\r\n//\r\n// Two kinds of caller reach Firestore through these rules:\r\n//\r\n//   * the Flutter app     -- signed in with email/password or Google\r\n//   * the web simulator   -- signed in anonymously\r\n//\r\n// The backend worker uses the Admin SDK, which bypasses rules entirely. That\r\n// asymmetry is the design: anything only the worker may write is simply denied\r\n// to everybody here, and the worker still writes it.\r\n//\r\n// There is no `ownerId` scoping. This is one shared house -- the app, the\r\n// simulator and the worker all look at the same devices. Per-user devices would\r\n// make the simulator unable to mirror the app at all.\r\n//\r\n// Deploy:  firebase deploy --only firestore:rules\r\n\r\nservice cloud.firestore {\r\n  match /databases/{database}/documents {\r\n\r\n    function signedIn() {\r\n      return request.auth != null;\r\n    }\r\n\r\n    // Which fields this update actually touches.\r\n    function changed() {\r\n      return request.resource.data.diff(resource.data).affectedKeys();\r\n    }\r\n\r\n    function validStatus() {\r\n      return request.resource.data.status in ['on', 'off', 'error', 'disconnected'];\r\n    }\r\n\r\n    // lastAlert / lastAlertAt are written by the worker only. A client that\r\n    // could set them could fake a safety alert on any device.\r\n    function noBackendOnlyFields() {\r\n      return !changed().hasAny(['lastAlert', 'lastAlertAt']);\r\n    }\r\n\r\n    match /floors/{floorId} {\r\n      allow read: if signedIn();\r\n      allow create, update, delete: if signedIn();\r\n    }\r\n\r\n    match /rooms/{roomId} {\r\n      allow read: if signedIn();\r\n      allow create, update, delete: if signedIn();\r\n    }\r\n\r\n    match /devices/{deviceId} {\r\n      allow read: if signedIn();\r\n      allow create, delete: if signedIn();\r\n\r\n      // The field list is closed: an unknown field name is rejected rather\r\n      // than silently stored. With three separate clients writing to one\r\n      // collection, that is what keeps them honest about the schema -- a typo\r\n      // fails loudly instead of creating a field nobody reads.\r\n      allow update: if signedIn()\r\n        && validStatus()\r\n        && noBackendOnlyFields()\r\n        && changed().hasOnly([\r\n             'id', 'name', 'type', 'roomId', 'floorId',\r\n             'status', 'statusReason', 'turnedOnAt',\r\n             'childSwitches', 'switches',\r\n             'maxOnDurationMinutes',\r\n             'scheduleStartTime', 'scheduleEndTime',\r\n             'scheduleDays', 'scheduleEnabled',\r\n             'cameraImageUrls', 'iconName', 'powerUsage',\r\n             'lastHeartbeat', 'updatedBy', 'lastUpdated'\r\n           ]);\r\n    }\r\n\r\n    // Usage history is evidence. The worker writes it through the Admin SDK;\r\n    // no client can add to it, edit it, or quietly erase a session.\r\n    match /usage_logs/{logId} {\r\n      allow read: if signedIn();\r\n      allow write: if false;\r\n    }\r\n\r\n    // Alerts are raised by the worker. A client may only acknowledge one.\r\n    match /alerts/{alertId} {\r\n      allow read: if signedIn();\r\n      allow create: if false;\r\n      allow update: if signedIn() && changed().hasOnly(['acknowledged']);\r\n      allow delete: if signedIn();\r\n    }\r\n\r\n    // Anything not named above is closed.\r\n    match /{document=**} {\r\n      allow read, write: if false;\r\n    }\r\n  }\r\n}\r\n","name":"firestore.rules"}]},"createTime":"2026-08-16T16:31:36.968943Z","metadata":{"services":["cloud.firestore"]}}
