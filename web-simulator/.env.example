# Copy to web-simulator/.env and paste your project's web config.
#
# Firebase console -> Project settings -> General -> Your apps -> Web app.
# The same values flutterfire wrote into lib/firebase_options.dart under
# `static const FirebaseOptions web`.
#
# These keys are not secrets: they identify the project, they do not grant
# access. What protects the data is firestore.rules plus an authenticated
# session. Do not put a service account key in here -- that one *is* a secret
# and belongs only in worker/serviceAccount.json.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
